<?xml version="1.0" encoding="utf-8"?>
<!-- Copia automática y pase a otro teléfono (Android 12 o más nuevo). Se
     copia todo menos las claves de IA de los usuarios (ver backup_rules). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/claves_ia.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/claves_ia.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
