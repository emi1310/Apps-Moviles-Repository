<?xml version="1.0" encoding="utf-8"?>
<!-- Copia automática de Android (hasta Android 11). Se copia todo menos las
     claves de IA de los usuarios: están cifradas con una llave que no sale
     del teléfono, así que en otro no servirían. -->
<full-backup-content>
    <exclude domain="file" path="datastore/claves_ia.preferences_pb" />
</full-backup-content>
