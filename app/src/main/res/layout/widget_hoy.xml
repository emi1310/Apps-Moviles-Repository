<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Hoy" de Estudia+: la fecha y lo que hay hoy (clases, exámenes,
     entregas, bloques de estudio y tareas que vencen). Tocarlo abre la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hoy_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_widget"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_hoy_titulo"
            android:textColor="@color/widget_acento"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hoy_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_texto_secundario"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/hoy_linea_1" style="@style/TareaWidget" />
    <TextView android:id="@+id/hoy_linea_2" style="@style/TareaWidget" />
    <TextView android:id="@+id/hoy_linea_3" style="@style/TareaWidget" />
    <TextView android:id="@+id/hoy_linea_4" style="@style/TareaWidget" />
    <TextView android:id="@+id/hoy_linea_5" style="@style/TareaWidget" />

    <TextView
        android:id="@+id/hoy_mas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_texto_secundario"
        android:textSize="12sp" />
</LinearLayout>
