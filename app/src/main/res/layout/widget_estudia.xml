<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de Estudia+: arriba el nombre y la racha; debajo las próximas
     tareas pendientes (hasta 3). Tocarlo abre la app. RemoteViews solo
     admite vistas simples (LinearLayout, TextView...), sin Compose. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_widget"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_acento"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_racha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_fuego"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_texto_secundario"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_tarea_1"
        style="@style/TareaWidget" />

    <TextView
        android:id="@+id/widget_tarea_2"
        style="@style/TareaWidget" />

    <TextView
        android:id="@+id/widget_tarea_3"
        style="@style/TareaWidget" />
</LinearLayout>
