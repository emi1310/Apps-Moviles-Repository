<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos: solo los mínimos necesarios.
         POST_NOTIFICATIONS: mostrar recordatorios (Android 13+ lo pide en
         tiempo de ejecución, cuando el usuario activa "Recordatorios").
         READ_MEDIA_IMAGES (Android 13+) / READ_EXTERNAL_STORAGE (hasta Android 12):
         leer fotos para adjuntarlas. Se pide una sola vez, la primera vez que
         el usuario adjunta algo, después de explicarle para qué es. Si no lo
         da, igual puede adjuntar con el selector del sistema (que da acceso
         solo al archivo elegido). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".EstudiaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Estudia">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Estudia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Botones de la notificación del temporizador. No es "exported": solo
             la puede llamar la propia app (desde su notificación). -->
        <receiver
            android:name=".notificaciones.TemporizadorReceiver"
            android:exported="false" />

        <!-- Comparte los adjuntos (filesDir/archivos) con otras apps para
             abrirlos, con acceso temporal de solo lectura. No es exportado:
             solo se accede con el permiso que da cada Intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
    </application>

</manifest>