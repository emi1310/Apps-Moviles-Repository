<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos: solo los mínimos necesarios.
         POST_NOTIFICATIONS: mostrar recordatorios (Android 13+ lo pide en
         tiempo de ejecución, cuando el usuario activa "Recordatorios").
         READ_MEDIA_IMAGES (Android 13+) / READ_EXTERNAL_STORAGE (hasta Android 12):
         leer fotos y archivos para adjuntarlos. Se pide al tocar "Adjuntar",
         después de explicar para qué es. Sin este permiso no se puede adjuntar.
         READ_MEDIA_VISUAL_USER_SELECTED (Android 14+): el "acceso limitado". -->
    <!-- Para bajar los feriados de internet si no están en el calendario del teléfono. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- CAMERA: sacar la foto de perfil o una foto para una nota o materia.
         Se pide al tocar "Sacar foto", después de explicar para qué es.
         uses-feature con required="false": la app se puede instalar en
         teléfonos sin cámara (el botón avisa que no hay cámara). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Grabar audio (la clase) para adjuntarlo a una nota. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Aviso al llegar a la facultad: la ubicación (también en segundo plano,
         para enterarse de la llegada con la app cerrada) y volver a armar el
         aviso cuando se reinicia el teléfono. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- ACCESS_NOTIFICATION_POLICY: activar "No molestar" mientras corre el
         temporizador. No es un permiso que se pida con un diálogo: el
         usuario lo da en Ajustes (la app lo lleva a esa pantalla). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- READ_CALENDAR / WRITE_CALENDAR: pasar las clases, exámenes y
         entregas al calendario del teléfono. Se piden al tocar "Pasar al
         calendario del teléfono", después de explicar para qué son. La app
         solo usa su propio calendario ("Estudia+"). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Para saber si está la app de Gemini (el + del Asistente la abre). -->
    <queries>
        <package android:name="com.google.android.apps.bard" />
    </queries>

    <application
        android:name=".EstudiaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Estudia">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Estudia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Botones de la notificación del temporizador. No es "exported": solo
             la puede llamar la propia app (desde su notificación). -->
        <receiver
            android:name=".notificaciones.TemporizadorReceiver"
            android:exported="false" />

        <!-- Widget de la pantalla de inicio (racha y próximas tareas). Tiene
             que ser "exported" para que el launcher lo pueda mostrar y el
             sistema le mande las actualizaciones. -->
        <receiver
            android:name=".widget.WidgetEstudia"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_widget" />
        </receiver>

        <!-- Widget "Hoy" (clases, exámenes, entregas y tareas del día). -->
        <receiver
            android:name=".widget.WidgetHoy"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_widget_hoy" />
        </receiver>

        <!-- Widget "Panel": botones que abren la app directo en una función. -->
        <receiver
            android:name=".widget.WidgetPanel"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_widget_panel" />
        </receiver>

        <!-- Widget "Estudiar": la sesión del temporizador con sus botones. -->
        <receiver
            android:name=".widget.WidgetTemporizador"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_widget_temporizador" />
        </receiver>

        <!-- Widget "Próximo examen". -->
        <receiver
            android:name=".widget.WidgetExamen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_widget_examen" />
        </receiver>

        <!-- Acciones de los widgets sin abrir la app (completar una tarea).
             No es "exported": solo lo llaman los widgets de la propia app. -->
        <receiver
            android:name=".widget.WidgetAccionesReceiver"
            android:exported="false" />

        <!-- Aviso al llegar a la facultad: lo llama Google Play Services al
             entrar en la zona, y al reiniciar el teléfono se vuelve a armar. -->
        <receiver
            android:name=".notificaciones.LlegadaReceiver"
            android:exported="false" />
        <!-- Silenciar en clase: la alarma de cada comienzo y fin de clase. -->
        <receiver
            android:name=".notificaciones.SilencioClaseReceiver"
            android:exported="false" />
        <receiver
            android:name=".notificaciones.ArranqueReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Comparte los adjuntos (filesDir/archivos) con otras apps para
             abrirlos, con acceso temporal de solo lectura. No es exportado:
             solo se accede con el permiso que da cada Intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
    </application>

</manifest>
